# CREDENTIALS. The Device Portal user and password live in
# %LOCALAPPDATA%\xbox-devportal\credenciales.txt, outside this tree, and must never be
# committed: a public repository cannot be un-leaked.
credenciales.txt
credentials.txt
.env
*.env
secrets.*

# saves, caches, logs and measurements
*.sav
*.log
*.txt.bak
smash.log
arranque.log
traza.txt
espacio.txt
huella.txt
cache/
save/
mediciones/

# screenshots of a console carry its name and IP: look at every one before adding it
capturas/
screenshots/

# Python
