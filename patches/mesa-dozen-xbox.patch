+/* Close() no dice que comando rechazo. El InfoQueue del dispositivo si, siempre que la capa
+ * de depuracion este encendida (DZN_DEBUG=d3d12). */
+static void
+dzn_cmd_buffer_dump_messages(struct dzn_cmd_buffer *cmdbuf, HRESULT hres)
+{
+   struct dzn_device *device = container_of(cmdbuf->vk.base.device, struct dzn_device, vk);
+
+   fprintf(stderr, "dzn: ID3D12GraphicsCommandList::Close = 0x%08lx\n", (unsigned long)hres);
+
+   ID3D12InfoQueue *iq = NULL;
+   if (FAILED(ID3D12Device4_QueryInterface(device->dev, &IID_ID3D12InfoQueue, (void **)&iq))) {
+      fprintf(stderr, "dzn: sin InfoQueue; arranca con DZN_DEBUG=d3d12 para saber el motivo\n");
+      fflush(stderr);
+      return;
+   }
+
+   const UINT64 n = ID3D12InfoQueue_GetNumStoredMessages(iq);
+   if (n == 0)
+      fprintf(stderr, "dzn: el InfoQueue esta vacio: la capa de depuracion esta apagada\n");
+   for (UINT64 i = 0; i < n; i++) {
+      SIZE_T len = 0;
+      if (FAILED(ID3D12InfoQueue_GetMessage(iq, i, NULL, &len)))
+         continue;
+      D3D12_MESSAGE *m = malloc(len);
+      if (!m)
+         continue;
+      if (SUCCEEDED(ID3D12InfoQueue_GetMessage(iq, i, m, &len)))
+         fprintf(stderr, "dzn: D3D12 #%u: %s\n", (unsigned)m->ID, m->pDescription);
+      free(m);
+   }
+   ID3D12InfoQueue_ClearStoredMessages(iq);
+   ID3D12InfoQueue_Release(iq);
+   fflush(stderr);
+}
