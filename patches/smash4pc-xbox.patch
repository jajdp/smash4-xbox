+// ¿Se puede crear de verdad una imagen de profundidad de este formato? Declararlo apto no
+// basta: una Xbox dice que si y luego pide 0 bytes para la imagen, que es lo mismo que no.
+bool depth_usable(VkPhysicalDevice physical, VkDevice device, VkFormat format) {
+    if (device == VK_NULL_HANDLE) {
+        return supported(physical, format,
+                         VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT);
+    }
+    if (!supported(physical, format,
+                   VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT)) {
+        return false;
+    }
+    VkImageCreateInfo ici{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ici.imageType = VK_IMAGE_TYPE_2D;
+    ici.format = format;
+    ici.extent = {64, 64, 1};
+    ici.mipLevels = 1;
+    ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT;
+    ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkImage prueba = VK_NULL_HANDLE;
+    if (vkCreateImage(device, &ici, nullptr, &prueba) != VK_SUCCESS) return false;
+    VkMemoryRequirements req{};
+    vkGetImageMemoryRequirements(device, prueba, &req);
+    vkDestroyImage(device, prueba, nullptr);
+    return req.size != 0;
+}
