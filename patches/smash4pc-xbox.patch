+static void forzar_pantalla_completa(std::string& glsl, uint64_t program_hash) {
+    static const uint64_t objetivo = [] {
+        const char* v = std::getenv("TTT2_VS_FIJO");
+        return v != nullptr && *v != 0 ? std::strtoull(v, nullptr, 16) : 0ull;
