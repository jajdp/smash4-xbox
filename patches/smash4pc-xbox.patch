+// ------------------------------------------------- push descriptors without the extension
+// Direct3D 12 has no equivalent of VK_KHR_push_descriptor, so Dozen does not offer it and the
+// renderer allocates a descriptor set per push instead. The sets come from one pool per command
+// buffer slot, and a slot's pool is reset when the renderer reuses that slot -- which it only
+// does after waiting for the GPU to finish the slot's work, so no set in use is ever freed.
+
+namespace {
+// Sets per pool. Pools are per slot and a slot holds the draws of one submission; when one is not
+// enough (a long submission, or sets that each take many textures) another pool joins the list,
+// so this is a starting size and not a limit.
+constexpr uint32_t kSetsPerPool = 256;
+} // namespace
+
+VkDescriptorPool Context::create_descriptor_pool() {
+    // Per set: up to three uniform buffers (draw constants, VS and PS registers) and up to 18
+    // textures per stage; presentation needs a sampler, a storage image and a storage buffer. The
+    // texture count here is a typical draw, not the worst case -- see kSetsPerPool.
+    const VkDescriptorPoolSize sizes[] = {
+        {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 3 * kSetsPerPool},
+        {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 10 * kSetsPerPool},
+        {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, kSetsPerPool},
+        // kGuestRegions por set de dibujo (las regiones de memoria del invitado) y uno para el de
+        // presentacion; tres cubre ambos con holgura.
+        {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 3 * kSetsPerPool},
+    };
+    VkDescriptorPoolCreateInfo ci{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    ci.maxSets = kSetsPerPool;
+    ci.poolSizeCount = 4;
+    ci.pPoolSizes = sizes;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VK_CHECK(vkCreateDescriptorPool(device, &ci, nullptr, &pool));
+    return pool;
+}
+
+void Context::register_set_layout(VkPipelineLayout layout, VkDescriptorSetLayout set_layout) {
+    if (push_descriptor) return; // the driver pushes; there is nothing to look up later
+    std::lock_guard lock(set_layouts_mutex);
+    set_layouts[layout] = set_layout;
+}
+
+void Context::reset_descriptor_pool(uint32_t pool) {
+    if (push_descriptor || pool >= kDescriptorPools) return;
+    for (VkDescriptorPool p : descriptor_pools[pool]) VK_CHECK(vkResetDescriptorPool(device, p, 0));
+    descriptor_pool_cursor[pool] = 0;
+    descriptor_sets_served[pool] = 0;
+}
+
+void Context::push_descriptor_set(VkCommandBuffer cmd, VkPipelineBindPoint bind_point, VkPipelineLayout layout,
+                                  uint32_t set, uint32_t count, const VkWriteDescriptorSet* writes, uint32_t pool) {
+    if (push_descriptor) {
+        cmd_push_descriptor_set(cmd, bind_point, layout, set, count, writes);
+        return;
+    }
+    if (pool >= kDescriptorPools) fatal("Vulkan: push descriptors: pool %u out of range", pool);
+    VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+    {
+        std::lock_guard lock(set_layouts_mutex);
+        const auto it = set_layouts.find(layout);
+        if (it == set_layouts.end()) fatal("Vulkan: push descriptors: a pipeline layout was never registered");
+        set_layout = it->second;
+    }
+    std::vector<VkDescriptorPool>& pools = descriptor_pools[pool];
+    uint32_t& cursor = descriptor_pool_cursor[pool];
+    VkDescriptorSetAllocateInfo ai{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    ai.descriptorSetCount = 1;
+    ai.pSetLayouts = &set_layout;
+    VkDescriptorSet destination = VK_NULL_HANDLE;
+    for (uint32_t attempt = 0;; ++attempt) {
+        if (cursor >= pools.size()) {
+            // Se acabo el sitio: quien graba tiene que cerrar la tanda para que los sets vuelvan.
+            // Mientras tanto se hace uno nuevo, porque este dibujo ya esta a medias.
+            pools.push_back(create_descriptor_pool());
+            descriptor_pool_grew = true;
+            // Cuantos van. Si esto crece sin parar, cerrar la tanda no esta devolviendo los
+            // sets y lo que se come la memoria son los pools.
+            ++descriptor_pools_total;
+            if (descriptor_pools_total % 8 == 0) {
+                std::fprintf(stderr, "ttt2: GPU: ya van %u pools de descriptores (slot %u tiene %zu)\n",
+                             descriptor_pools_total, pool, pools.size());
+            }
+        }
+        ai.descriptorPool = pools[cursor];
+        const VkResult r = vkAllocateDescriptorSets(device, &ai, &destination);
+        if (r == VK_SUCCESS) break;
+        // A full or fragmented pool is not an error here: it means this slot moves on to the
+        // next one, and only makes a new one once they are all spent.
+        if (r != VK_ERROR_OUT_OF_POOL_MEMORY && r != VK_ERROR_FRAGMENTED_POOL) {
+            check_failed("vkAllocateDescriptorSets", r, __FILE__, __LINE__);
+        }
+        if (attempt >= 1024) fatal("Vulkan: push descriptors: pool %u stopped growing", pool);
+        ++cursor;
+        // TTT2_TRACE_POOLS: ¿se estabiliza el numero de pools por slot o crece sin parar? Lo
+        // segundo significa que algo no se esta liberando.
+        if (std::getenv("TTT2_TRACE_POOLS")) {
+            std::fprintf(stderr, "ttt2: GPU: slot %u pasa a su pool %u de %zu, con %u sets servidos "
+                                 "desde el ultimo reset\n",
+                         pool, cursor + 1, pools.size(), descriptor_sets_served[pool]);
+        }
+    }
+    ++descriptor_sets_served[pool];
