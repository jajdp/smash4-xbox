+// ---- keeping the copies in step (no-ops when the regions are in place) ----------------
+
+bool GuestMemory::pages_of(const Block& b, uint32_t address, uint32_t size, uint32_t& first, uint32_t& last) {
+    if (address >= uint64_t{b.base} + b.size || uint64_t{address} + size <= b.base) return false;
+    const uint32_t from = address > b.base ? address - b.base : 0;
+    const uint64_t to = std::min<uint64_t>(uint64_t{address} + size - b.base, b.size);
+    first = from >> kPageShift;
+    last = static_cast<uint32_t>((to - 1) >> kPageShift);
+    return true;
