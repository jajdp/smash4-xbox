+/* --- UWP: LoadLibraryA no esta permitida en el contenedor ------------------------------
+ *
+ * Una app empaquetada solo puede cargar bibliotecas de su propio paquete
+ * (LoadPackagedLibrary) o del sistema (LoadLibraryExW + LOAD_LIBRARY_SEARCH_SYSTEM32).
+ * DXIL.dll viaja en el paquete y DXGI.DLL es del sistema, asi que se prueban los dos. */
+#include <stdio.h>
+
+static HMODULE uwp_cargar(const char *nombre)
+{
+   /* El paquete puede traer el archivo con otra caja que la que pide quien lo busca
+    * («dxil.dll» contra «DXIL.dll»), y LoadPackagedLibrary no perdona eso. Se prueban las
+    * tres grafias, y despues el sistema, que es de donde viene DXGI. */
+   char copia[260];
+   wchar_t ancho[260];
+   HMODULE m = NULL;
+   int i, paso;
+   for (paso = 0; paso < 3 && m == NULL; paso++) {
+      for (i = 0; nombre[i] != 0 && i < 259; i++) {
+         char c = nombre[i];
+         if (paso == 1 && c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
+         if (paso == 2 && c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
+         copia[i] = c;
+      }
+      copia[i] = 0;
+      if (MultiByteToWideChar(CP_ACP, 0, copia, -1, ancho, 260) <= 0)
+         continue;
+      m = LoadPackagedLibrary(ancho, 0);
+      if (m == NULL)
+         m = LoadLibraryExW(ancho, NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+      if (m != NULL)
+         fprintf(stderr, "dzn: %s cargada como %s\n", nombre, copia);
+   }
+   if (m == NULL)
+      fprintf(stderr, "dzn: NO pude cargar %s (ni en el paquete ni en el sistema)\n", nombre);
+   return m;
+}
