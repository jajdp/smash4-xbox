+// Entry point for the packaged build (UWP: an Xbox in developer mode).
+//
+// A packaged app starts at CoreApplication, not at main(). SDL carries that shell inside
+// SDL_RunApp: it creates the CoreWindow and calls the app's function on its own thread, which is
+// where smash_main() is entered. Same shape as the Brawl port.
+//
+// There is no command line either, so the title folders come from a text file in LocalState,
+// one argument per line -- the same arguments the desktop build takes:
+//
+//     --dlc
+//     <the DLC folder>
+//     <the update folder>
+//     <the game folder>
+//
+// Lines that are empty or start with # are skipped, so the file can carry a comment.
+
+#include <windows.h>
+
+#include "host/window.h"
+
+#include <SDL3/SDL.h>
+// SDL_MAIN_HANDLED: without it SDL_main.h defines its own WinMain and the one below is a
+// redefinition. The shell here is the entry point; SDL_RunApp is called by hand.
+#define SDL_MAIN_HANDLED
+#include <SDL3/SDL_main.h>
+
+#include <vulkan/vulkan.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <exception>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+int smash_main(int argc, char** argv);
+
+// The shim that stands in for the Vulkan loader reports through this (see vkshim.cpp). It is the
+// only way to tell "the driver DLL did not load" from "it loaded and said no".
+extern "C" void (*uwp_vkshim_log)(const char* where, const char* text);
+
+namespace {
+
+constexpr const char* kArgumentsFile = "rutas.txt";
+
+// A line in the log that exists before the title opens its own: on the console there is no
+// console and no debugger. It goes to LocalState, which the Device Portal lists and serves --
+// \AC\Temp also exists but came back empty through the portal.
+void trace(const std::string& text) {
+    static const std::wstring path = [] {
+        char* pref = SDL_GetPrefPath(nullptr, "Smash4");
+        std::wstring folder;
+        if (pref != nullptr) {
+            const std::filesystem::path p(pref);
+            SDL_free(pref);
+            folder = p.wstring();
+        } else {
+            wchar_t temp[MAX_PATH]{};
+            if (GetTempPathW(MAX_PATH, temp) != 0) folder = temp;
+        }
+        return folder.empty() ? std::wstring() : folder + L"traza.txt";
+    }();
+    if (path.empty()) return;
+    HANDLE file = CreateFile2(path.c_str(), FILE_APPEND_DATA, FILE_SHARE_READ, OPEN_ALWAYS, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return;
+    const std::string line = text + "\r\n";
+    DWORD written = 0;
+    WriteFile(file, line.data(), static_cast<DWORD>(line.size()), &written, nullptr);
+    CloseHandle(file);
+}
+
+std::filesystem::path local_state() {
+    char* pref = SDL_GetPrefPath(nullptr, "Smash4");
+    if (pref == nullptr) return {};
+    std::filesystem::path path(pref);
+    SDL_free(pref);
+    return path;
+}
+
+// The arguments file, or an empty list with a note in the trace when it is not there.
+std::vector<std::string> read_arguments(const std::filesystem::path& folder) {
+    std::vector<std::string> arguments;
+    const std::filesystem::path file = folder / kArgumentsFile;
+    std::ifstream in(file);
+    if (!in) {
+        trace("no encuentro " + file.string() + ": sin rutas del volcado no hay nada que cargar");
+        return arguments;
+    }
+    std::string line;
+    while (std::getline(in, line)) {
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+        if (line.empty() || line[0] == '#') continue;
+        arguments.push_back(line);
+    }
+    trace("rutas.txt: " + std::to_string(arguments.size()) + " argumentos");
+    return arguments;
+}
+
+// What the driver on this machine offers, written to LocalState. Only the handful of things the
+// renderer actually asks for, so the answer is a yes or a no and not a wall of text:
+// buffer_device_address and descriptor_indexing are the interesting ones, because Dozen ties both
+// to Shader Model 6.6 and an Xbox in developer mode reports Direct3D feature level 11_0.
+// Cuanto cabe todavia donde vive el LocalState. Hace falta medirlo AQUI: el panel de la
+// consola informa del disco entero (cientos de GB) y no de la particion de desarrollo, y el
+// Device Portal no expone el dato por ninguna via.
+void report_espacio(const std::filesystem::path& folder) {
+    std::ofstream out(folder / "espacio.txt", std::ios::trunc);
+    const std::wstring ruta = folder.wstring();
+    ULARGE_INTEGER para_mi{}, total{}, libre{};
+    if (!GetDiskFreeSpaceExW(ruta.c_str(), &para_mi, &total, &libre)) {
+        out << "GetDiskFreeSpaceExW fallo con " << GetLastError() << "\n";
+        trace("espacio.txt: GetDiskFreeSpaceExW fallo");
+        return;
+    }
+    const double giga = 1024.0 * 1024.0 * 1024.0;
+    out.setf(std::ios::fixed);
+    out.precision(2);
+    out << "Espacio donde vive el LocalState de este paquete.\n\n";
+    out << "Ruta:  " << folder.string() << "\n";
+    out << "Total: " << (total.QuadPart / giga) << " GiB\n";
+    out << "Libre: " << (libre.QuadPart / giga) << " GiB\n";
+    out << "Libre para este usuario: " << (para_mi.QuadPart / giga) << " GiB\n";
+    out << "\n(el volcado de Smash 4 son 13,67 GiB)\n";
+    out.close();
+    char linea[160];
+    std::snprintf(linea, sizeof(linea), "espacio: %.2f GiB libres de %.2f GiB",
+                  libre.QuadPart / giga, total.QuadPart / giga);
+    trace(linea);
+}
+
+void report_vulkan(const std::filesystem::path& folder) {
+    std::ofstream out(folder / "vulkan.txt", std::ios::trunc);
+    out << "Lo que ofrece el driver de esta maquina.\n\n";
+
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.apiVersion = VK_API_VERSION_1_2;
+    VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app;
+    VkInstance instance = VK_NULL_HANDLE;
+    if (const VkResult r = vkCreateInstance(&ici, nullptr, &instance); r != VK_SUCCESS) {
+        out << "vkCreateInstance fallo con " << r << "\n";
+        out << "(si es -3, VK_ERROR_INITIALIZATION_FAILED, lo normal es que falte DXIL.dll)\n";
+        return;
+    }
+    uint32_t count = 0;
+    vkEnumeratePhysicalDevices(instance, &count, nullptr);
+    std::vector<VkPhysicalDevice> devices(count);
+    vkEnumeratePhysicalDevices(instance, &count, devices.data());
+    out << count << " dispositivo(s)\n";
+
+    for (VkPhysicalDevice device : devices) {
+        VkPhysicalDeviceProperties p;
+        vkGetPhysicalDeviceProperties(device, &p);
+        out << "\n== " << p.deviceName << "\n";
+        out << "   Vulkan " << VK_API_VERSION_MAJOR(p.apiVersion) << "." << VK_API_VERSION_MINOR(p.apiVersion)
+            << "." << VK_API_VERSION_PATCH(p.apiVersion) << ", driver " << p.driverVersion << "\n";
+
+        uint32_t n = 0;
+        vkEnumerateDeviceExtensionProperties(device, nullptr, &n, nullptr);
+        std::vector<VkExtensionProperties> extensions(n);
+        vkEnumerateDeviceExtensionProperties(device, nullptr, &n, extensions.data());
+        out << "   " << n << " extensiones\n";
+        static const char* const wanted[] = {
+            VK_KHR_SWAPCHAIN_EXTENSION_NAME, VK_KHR_DYNAMIC_RENDERING_EXTENSION_NAME,
+            VK_KHR_SYNCHRONIZATION_2_EXTENSION_NAME, VK_KHR_BUFFER_DEVICE_ADDRESS_EXTENSION_NAME,
+            VK_EXT_DESCRIPTOR_INDEXING_EXTENSION_NAME, VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME,
+            VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME, VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME,
+        };
+        for (const char* name : wanted) {
+            bool found = false;
+            for (const auto& e : extensions) found = found || std::strcmp(e.extensionName, name) == 0;
+            out << "   " << (found ? "SI " : "NO ") << name << "\n";
+        }
+
+        VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+        VkPhysicalDeviceFeatures2 f2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+        f2.pNext = &f12;
+        vkGetPhysicalDeviceFeatures2(device, &f2);
+        out << "   bufferDeviceAddress: " << (f12.bufferDeviceAddress ? "SI" : "NO")
+            << "   (lo exige el renderizador)\n";
+        out << "   timelineSemaphore:   " << (f12.timelineSemaphore ? "SI" : "NO") << "\n";
+        out << "   textureCompressionBC: " << (f2.features.textureCompressionBC ? "SI" : "NO") << "\n";
+
+        // Depth formats: Dozen can call one supported and then want 0 bytes for its image, which
+        // is what left Yakumo's picture black until it fell back to D24_UNORM_S8_UINT.
+        static const std::pair<VkFormat, const char*> depths[] = {
+            {VK_FORMAT_D16_UNORM, "D16_UNORM"},
+            {VK_FORMAT_D32_SFLOAT, "D32_SFLOAT"},
+            {VK_FORMAT_D24_UNORM_S8_UINT, "D24_UNORM_S8_UINT"},
+            {VK_FORMAT_D32_SFLOAT_S8_UINT, "D32_SFLOAT_S8_UINT"},
+        };
+        for (const auto& [format, name] : depths) {
+            VkFormatProperties fp;
+            vkGetPhysicalDeviceFormatProperties(device, format, &fp);
+            out << "   profundidad " << name << ": "
+                << ((fp.optimalTilingFeatures & VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT) ? "apto" : "no")
+                << "\n";
+        }
+
+        // What the renderer needs now that it reads guest memory through storage buffers it
+        // keeps copies in (see GuestMemory): how much of one a shader may see, how many it can
+        // bind, and whether a gigabyte of host-visible memory can actually be had.
+        const VkPhysicalDeviceLimits& lim = p.limits;
+        out << "   maxStorageBufferRange: " << (lim.maxStorageBufferRange >> 20) << " MiB"
+            << "   (MEM2 son 1024 MiB: por debajo, se parte en ventanas)\n";
+        out << "   maxPerStageDescriptorStorageBuffers: " << lim.maxPerStageDescriptorStorageBuffers
+            << "   (el ABI pide 24)\n";
+        out << "   maxMemoryAllocationSize: ";
+        {
+            VkPhysicalDeviceMaintenance3Properties m3{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_3_PROPERTIES};
+            VkPhysicalDeviceProperties2 p2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+            p2.pNext = &m3;
+            vkGetPhysicalDeviceProperties2(device, &p2);
+            out << (m3.maxMemoryAllocationSize >> 20) << " MiB\n";
+        }
+
+        // The real test: a device, a gigabyte of host-visible memory, and two overlapping
+        // windows bound to it as storage buffers, which is exactly what GuestMemory::init does.
+        out << "   -- prueba de memoria del invitado copiada --\n";
+        uint32_t families = 0;
+        vkGetPhysicalDeviceQueueFamilyProperties(device, &families, nullptr);
+        std::vector<VkQueueFamilyProperties> fam(families);
+        vkGetPhysicalDeviceQueueFamilyProperties(device, &families, fam.data());
+        uint32_t family = UINT32_MAX;
+        for (uint32_t i = 0; i < families; ++i) {
+            if (fam[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) { family = i; break; }
+        }
+        if (family == UINT32_MAX) { out << "   sin cola grafica; no se prueba\n"; continue; }
+        const float priority = 1.0f;
+        VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+        qci.queueFamilyIndex = family;
+        qci.queueCount = 1;
+        qci.pQueuePriorities = &priority;
+        VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+        dci.queueCreateInfoCount = 1;
+        dci.pQueueCreateInfos = &qci;
+        VkDevice dev = VK_NULL_HANDLE;
+        if (const VkResult r = vkCreateDevice(device, &dci, nullptr, &dev); r != VK_SUCCESS) {
+            out << "   vkCreateDevice fallo con " << r << "\n";
+            continue;
+        }
+        const VkDeviceSize block = 1024ull << 20;             // MEM2
+        const VkDeviceSize span = std::min<VkDeviceSize>(lim.maxStorageBufferRange, block);
+        const VkBufferUsageFlags usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                                         VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT |
+                                         VK_BUFFER_USAGE_INDEX_BUFFER_BIT;
+        VkBufferCreateInfo bci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+        bci.size = span;
+        bci.usage = usage;
+        VkBuffer b0 = VK_NULL_HANDLE, b1 = VK_NULL_HANDLE;
+        VkResult r = vkCreateBuffer(dev, &bci, nullptr, &b0);
+        out << "   buffer de " << (span >> 20) << " MiB: " << (r == VK_SUCCESS ? "SI" : "NO") << " (" << r << ")\n";
+        if (r == VK_SUCCESS) {
+            VkMemoryRequirements req{};
+            vkGetBufferMemoryRequirements(dev, b0, &req);
+            VkPhysicalDeviceMemoryProperties mem{};
+            vkGetPhysicalDeviceMemoryProperties(device, &mem);
+            const VkMemoryPropertyFlags want =
+                VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+            uint32_t type = UINT32_MAX;
+            for (uint32_t i = 0; i < mem.memoryTypeCount; ++i) {
+                if ((req.memoryTypeBits & (1u << i)) && (mem.memoryTypes[i].propertyFlags & want) == want) {
+                    type = i;
+                    break;
+                }
+            }
+            out << "   tipo de memoria host-visible para ese buffer: "
+                << (type == UINT32_MAX ? std::string("NINGUNO") : std::to_string(type)) << "\n";
+            if (type != UINT32_MAX) {
+                VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+                mai.allocationSize = block;
+                mai.memoryTypeIndex = type;
+                VkDeviceMemory memory = VK_NULL_HANDLE;
+                r = vkAllocateMemory(dev, &mai, nullptr, &memory);
+                out << "   asignar " << (block >> 20) << " MiB host-visible: "
+                    << (r == VK_SUCCESS ? "SI" : "NO") << " (" << r << ")\n";
+                if (r == VK_SUCCESS) {
+                    void* mapped = nullptr;
+                    r = vkMapMemory(dev, memory, 0, VK_WHOLE_SIZE, 0, &mapped);
+                    out << "   mapearla: " << (r == VK_SUCCESS ? "SI" : "NO") << " (" << r << ")\n";
+                    if (r == VK_SUCCESS && mapped) {
+                        std::memset(static_cast<char*>(mapped) + (block - 4096), 0xA5, 4096);
+                        out << "   escribir en su ultimo pagina: SI\n";
+                    }
+                    // Two windows over the same allocation, the second at half a span: the
+                    // overlap GuestMemory relies on.
+                    r = vkBindBufferMemory(dev, b0, memory, 0);
+                    out << "   ventana 0 en el desplazamiento 0: " << (r == VK_SUCCESS ? "SI" : "NO")
+                        << " (" << r << ")\n";
+                    if (vkCreateBuffer(dev, &bci, nullptr, &b1) == VK_SUCCESS) {
+                        r = vkBindBufferMemory(dev, b1, memory, span / 2);
+                        out << "   ventana 1 en el desplazamiento " << ((span / 2) >> 20) << " MiB: "
+                            << (r == VK_SUCCESS ? "SI" : "NO") << " (" << r << ")\n";
+                        vkDestroyBuffer(dev, b1, nullptr);
+                    }
+                    vkFreeMemory(dev, memory, nullptr);
+                }
+            }
+            vkDestroyBuffer(dev, b0, nullptr);
+        }
+        vkDestroyDevice(dev, nullptr);
+    }
+    vkDestroyInstance(instance, nullptr);
+    out.close();
+    trace("vulkan.txt escrito");
+}
+
+int bootstrap(int, char**) {
+    trace("bootstrap: dentro de SDL_RunApp");
+    uwp_vkshim_log = [](const char* where, const char* text) {
+        trace(std::string("[") + (where ? where : "") + "] " + (text ? text : ""));
+    };
+    // Windows.Gaming.Input for the console's controllers, and the on-screen keyboard for the
+    // places where the title asks for text.
+    SDL_SetHint(SDL_HINT_JOYSTICK_WGI, "true");
+    SDL_SetHint(SDL_HINT_ENABLE_SCREEN_KEYBOARD, "true");
+
+    const std::filesystem::path folder = local_state();
+    trace("LocalState: " + folder.string());
+    // Siempre, haya volcado o no: es el unico sitio desde donde se puede leer.
+    if (!folder.empty()) report_espacio(folder);
+    // El registro va junto al archivo de rutas, donde el Device Portal puede recogerlo. Y se
+    // abre AQUI, no dentro de smash_main: alli se abre despues de procesar los argumentos, asi
+    // que un fallo anterior —un fatal() al registrar el DLC, por ejemplo— se perdia entero,
+    // porque en UWP no hay consola a la que caer. Con stderr ya en un archivo, smash_main lo
+    // respeta: comprueba GetFileType y, viendo que es un archivo, no lo vuelve a abrir.
+    if (!folder.empty()) {
+        const std::string registro = (folder / "arranque.log").string();
+        if (std::freopen(registro.c_str(), "w", stderr) != nullptr) {
+            std::setvbuf(stderr, nullptr, _IONBF, 0);
+            trace("stderr -> " + registro);
+        } else {
+            trace("no pude abrir " + registro + " para el registro");
+        }
+    }
+
+    // Las partidas y la cache de shaders, a LocalState. Sin esto el runtime las pone junto al
+    // ejecutable —que en UWP esta en la carpeta de instalacion, de SOLO LECTURA— y el proceso
+    // se muere ahi mismo, sin mensaje y sin volcado de fallo.
+    if (!folder.empty()) {
+        std::error_code ec;
+        for (const char* nombre : {"save", "cache"}) {
+            const std::filesystem::path destino = folder / nombre;
+            std::filesystem::create_directories(destino, ec);
+            if (ec) trace(std::string("no pude crear ") + nombre + ": " + ec.message());
+        }
+        // ⚠ SDL_setenv_unsafe NO basta: escribe en la tabla de SDL y std::getenv del CRT no la
+        // ve. Hay que usar _putenv_s, que es la que lee getenv.
+        const auto poner = [&](const char* nombre, const std::filesystem::path& valor) {
+            const std::string v = valor.string();
+            SDL_setenv_unsafe(nombre, v.c_str(), 1);
+#ifdef _WIN32
+            _putenv_s(nombre, v.c_str());
+#else
+            setenv(nombre, v.c_str(), 1);
+#endif
+            const char* leido = std::getenv(nombre);
+            trace(std::string(nombre) + " = " + (leido ? leido : "(getenv no lo ve)"));
+        };
+        poner("SMASH_SAVE_DIR", folder / "save");
+        poner("SMASH_CACHE_DIR", folder / "cache");
+        // El registro: sin esto, smash_main se lo calcula solo a partir del ejecutable y acaba
+        // intentando escribir en la carpeta de instalacion, que es de SOLO LECTURA.
+        poner("SMASH_LOG", folder / "smash.log");
+        poner("SMASH_HUELLA", folder / "huella.txt");
+
+        // Variables puestas a mano, para probar sin recompilar: una por linea, CLAVE=valor.
+        // Aqui viven las trazas del driver (DZN_DEBUG, MESA_TRACE_ERRORS) y las opciones del
+        // runtime (TTT2_*). El archivo se sube por el Device Portal y no hace falta nada mas.
+        {
+            std::ifstream in(folder / "entorno.txt");
+            std::string linea;
+            while (in && std::getline(in, linea)) {
+                while (!linea.empty() && (linea.back() == '\r' || linea.back() == ' ' || linea.back() == '\t')) {
+                    linea.pop_back();
+                }
+                if (linea.empty() || linea[0] == '#') continue;
+                const std::size_t igual = linea.find('=');
+                if (igual == std::string::npos) continue;
+                const std::string clave = linea.substr(0, igual);
+                const std::string valor = linea.substr(igual + 1);
+                SDL_setenv_unsafe(clave.c_str(), valor.c_str(), 1);
+#ifdef _WIN32
+                _putenv_s(clave.c_str(), valor.c_str());
+#else
+                setenv(clave.c_str(), valor.c_str(), 1);
+#endif
+                trace("entorno.txt: " + clave + " = " + valor);
+            }
+        }
+    }
+    // Dozen pide el validador de DXIL al crear la instancia y, si no lo consigue, falla con
+    // VK_ERROR_INITIALIZATION_FAILED sin decir por que. El dxil.dll de Microsoft es de
+    // escritorio y no carga en el contenedor; con esto Dozen no lo pide.
+    {
+#ifdef _WIN32
+        /* Sin «experimental»: con esa bandera Dozen no pide el validador DXIL, pero entonces
+         * activa caracteristicas experimentales de D3D12 que la consola no concede y se queda SIN
+         * NI UN dispositivo. Con el dxil.dll bueno en el paquete, el validador carga y no hace falta. */
+        /* _putenv_s("DZN_DEBUG", "experimental"); */
+#else
+        setenv("DZN_DEBUG", "experimental", 1);
+#endif
+        trace("Dozen con su validador DXIL");
+        trace("partidas y cache en " + folder.string());
+    }
+
+    std::vector<std::string> arguments = read_arguments(folder);
+    if (arguments.empty()) {
+        // Nothing to load, so the run is spent on what the machine can tell us instead. On a
+        // console there is no vulkaninfo, and this is the only way to read what the driver there
+        // really offers before carrying 14 GB of game over.
+        report_vulkan(folder);
+        return 0;
+    }
