+
+void GuestMemory::mark(uint32_t address, uint32_t size, bool set) {
+    if (in_place_ || size == 0) return;
+    for (Block& b : blocks_) {
+        uint32_t p = 0, last = 0;
+        if (!pages_of(b, address, size, p, last)) continue;
+        // A word of the map at a time: a whole-word span is one operation, the ragged ends a mask.
+        while (p <= last) {
+            const uint32_t word_last = std::min(last, p | 63);
+            const uint32_t n = word_last - p + 1;
+            const uint64_t bits = (n == 64 ? ~uint64_t{0} : ((uint64_t{1} << n) - 1)) << (p & 63);
+            if (set) b.behind[p >> 6] |= bits;
+            else b.behind[p >> 6] &= ~bits;
+            p = word_last + 1;
+        }
+    }
+}
